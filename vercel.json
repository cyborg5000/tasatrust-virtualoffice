{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "tasatrust.com" }],
      "destination": "https://www.tasatrust.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap?kind=index"
    },
    {
      "source": "/sitemap-static.xml",
      "destination": "/api/sitemap?kind=static"
    },
    {
      "source": "/sitemap-blog.xml",
      "destination": "/api/sitemap?kind=blog"
    },
    {
      "source": "/((?!api/.*|_next/static|_next/image|favicon.ico|.*\\.png$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
